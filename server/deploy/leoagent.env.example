# /etc/leoagent.env
# Скопируйте этот файл в /etc/leoagent.env (chmod 600) и заполните.

# ── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather. Не храните его в репозитории — только в /etc/leoagent.env.
LEOAGENT_TG_TOKEN=

# Прокси для api.telegram.org. На российских VPS Telegram заблокирован,
# без прокси бот не подключится (ConnectTimeout).
# Форматы:
#   http://host:port
#   http://user:pass@host:port
#   socks5://host:port
#   socks5://user:pass@host:port
LEOAGENT_TG_PROXY=

# Список chat_id, которым разрешён доступ (через запятую).
# Если оставить пустым — любой, кто пришлёт /start, попадёт в список
# подписчиков и будет получать пуши.
LEOAGENT_TG_ADMINS=

# ── Капитал ─────────────────────────────────────────────────────────────────
LEOAGENT_CAPITAL=1000000

# ── Хранилище ───────────────────────────────────────────────────────────────
LEOAGENT_DATA_DIR=/opt/leoagent/data
LEOAGENT_DB=/opt/leoagent/data/agent_state.db
LEOAGENT_NEWS_FILE=/opt/leoagent/data/cbr_news.json
LEOAGENT_PRICE_CACHE=/opt/leoagent/data/price_cache.json

# ── Прокси ──────────────────────────────────────────────────────────────────
# Список прокси через запятую. Формат:
#   http://host:port
#   http://user:pass@host:port
#   socks5://user:pass@host:port
# Можно оставить пустым — тогда LeoAgent ходит напрямую (рискованно).
LEOAGENT_PROXIES=
# Альтернатива: положить proxies.txt в LEOAGENT_DATA_DIR (одна строка — один прокси).

# Если true — без прокси HTTP-запросы вообще не отправляются.
LEOAGENT_PROXY_REQUIRED=false

# User-Agent'ы через '|'. Если не задать — используется fake-useragent + статический пул.
LEOAGENT_USER_AGENTS=

# ── Интервалы (секунды) ────────────────────────────────────────────────────
LEOAGENT_PRICE_MIN_SEC=300
LEOAGENT_PRICE_MAX_SEC=900
LEOAGENT_NEWS_MIN_SEC=600
LEOAGENT_NEWS_MAX_SEC=1800
LEOAGENT_TICK_MIN_SEC=300
LEOAGENT_TICK_MAX_SEC=600

# ── Прочее ──────────────────────────────────────────────────────────────────
LEOAGENT_NEWS_CHANNEL=cbrstocks
LEOAGENT_LOG_LEVEL=INFO
